<odoo>

        <record id="project_wbs_build_view_tree" model="ir.ui.view">
            <field name="name">project.wbs.builds.tree</field>
            <field name="model">project.wbs.builds</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="project_wbs_id"/>
                    <field name="customer_id"/>
                    <field name="project_id"/>
                </tree>
            </field>
        </record>

        <record id="project_wbs_build_view_form" model="ir.ui.view">
            <field name="name">project.wbs.builds.form</field>
            <field name="model">project.wbs.builds</field>
            <field name="arch" type="xml">
                <form string="project_wbs_build_form" create="0">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="project_wbs_id"/>
                                <field name="customer_id"/>
                            </group>
                            <group>
                                <field name="project_id"/>
                                <field name="company_id"/>
                            </group>
                            <notebook>
                                <page string="Project Wbs Builds Lines">
                                    <field name="project_wbs_builds_line_ids">
                                        <tree editable="bottom">
                                            <field name="item_id"/>
                                            <field name="project_wbs_id" invisible="1"/>
                                            <field name="name"/>
                                            <field name="uom_id"/>
                                            <field name="qty"/>
                                            <field name="unit_price"/>
                                            <field name="sub_total" widget="monetary"
                                                   options="{'currency_field': 'currency_id'}"/>
                                        </tree>
                                    </field>

                                </page>
                            </notebook>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>


        <record id="project_wbs_build_action" model="ir.actions.act_window">
            <field name="name">Wbs Builds</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">project.wbs.builds</field>
            <field name="view_mode">tree,form</field>
        </record>

</odoo>