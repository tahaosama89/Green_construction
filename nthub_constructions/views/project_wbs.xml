<odoo>

        <record id="project_wbs_view_tree" model="ir.ui.view">
            <field name="name">project_wbs_view_tree</field>
            <field name="model">project.wbs</field>
            <field name="arch" type="xml">
                <tree string="tender_offer" create="0">
                    <field name="name"/>
                    <field name="date"/>
                    <field name="customer_id"/>
                    <field name="project_id"/>
                    <field name="company_id"/>
                </tree>
            </field>
        </record>
        <record id="project_wbs_view_form" model="ir.ui.view">
            <field name="name">project_wbs_view_form</field>
            <field name="model">project.wbs</field>
            <field name="arch" type="xml">
                <form string="tender_offer">
                    <header>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field nolabel="1" name="name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="customer_id"/>
                                <field name="project_id"/>
                            </group>
                            <group>
                                <field name="company_id" readonly="1"/>
                                <field name="currency_id" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Project Wbs Lines">
                                <field name="project_wbs_builds_ids">
                                    <form string="tender_offer">
                                        <sheet>
                                            <div class="oe_title">
                                                <h1>
                                                    <field nolabel="1" name="name"/>
                                                </h1>
                                            </div>
                                            <group>
                                                <group>
                                                    <field name="project_wbs_id" readonly="1"/>
                                                    <field name="customer_id"/>
                                                    <field name="project_id"/>
                                                </group>
                                                <group>
                                                    <field name="company_id" readonly="1"/>
                                                    <field name="currency_id" invisible="1"/>
                                                </group>
                                            </group>
                                            <notebook>
                                                <page string="Project Wbs Builds Lines">
                                                    <field name="project_wbs_builds_line_ids">
                                                        <tree editable="bottom">
                                                            <field name="item_id"/>
                                                            <field name="name"/>
                                                            <field name="uom_id"/>
                                                            <field name="qty"/>
                                                            <field name="unit_price"/>
                                                            <field name="template_id"/>
                                                            <field name="sub_total" widget="monetary"
                                                                   options="{'currency_field': 'currency_id'}"/>
                                                            <field name="flag"/>
                                                            <field name="company_id" invisible="1"/>
                                                            <field name="currency_id" invisible="1"/>
                                                            <field name="project_wbs_builds_id" invisible="1"/>
                                                        </tree>
                                                    </field>
                                                    <group class="oe_subtotal_footer oe_right" colspan="2">
                                                        <field name="total_cost" widget="monetary"
                                                               options="{'currency_field': 'currency_id'}"/>
                                                    </group>
                                                </page>
                                            </notebook>
                                        </sheet>
                                    </form>

                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="project_wbs_action" model="ir.actions.act_window">
            <field name="name">WBS</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">project.wbs</field>
            <field name="view_mode">tree,form</field>
        </record>

</odoo>


