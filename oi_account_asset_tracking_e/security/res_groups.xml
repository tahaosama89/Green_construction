<?xml version="1.0" ?>
<odoo>

	<record id="module_asset_tracking" model="ir.module.category">
	    <field name="name">Asset Tracking</field>
	</record>
	
	<record id="group_asset_tracking_user" model="res.groups">
	    <field name="name">User</field>
	    <field name="category_id" ref="module_asset_tracking"/>
	</record>
	
	<record id="group_asset_tracking_manager" model="res.groups">
	    <field name="name">Manager</field>
	    <field name="implied_ids" eval="[(4, ref('group_asset_tracking_user'))]"/>
	    <field name="category_id" ref="module_asset_tracking"/>
	    <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
	</record>
        
</odoo>
