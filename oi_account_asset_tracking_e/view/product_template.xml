<odoo>

	<record id="product_template_only_form_view" model="ir.ui.view">
		<field name="name">product.template_asset_tracking</field>
		<field name="model">product.template</field>
		<field name="inherit_id" ref="product.product_template_only_form_view"/>
		<field name="arch" type="xml">
			<div name="button_box" position="inside">
				<field name="asset_category_id" invisible="1" groups="oi_account_asset_tracking_e.group_asset_tracking_user"/>
				<button type="object" name="action_view_assets" class="oe_stat_button" icon="fa-laptop" groups="oi_account_asset_tracking_e.group_asset_tracking_user" invisible="not asset_category_id">
					<field name="asset_count" string="Assets" widget="statinfo" groups="oi_account_asset_tracking_e.group_asset_tracking_user"/>
				</button>
			</div>
		</field>
	</record>

</odoo>
