<?xml version="1.0" encoding="utf-8"?>
<odoo>

	<record id="act_asset_tracking" model="ir.actions.act_window">
		<field name="name">Asset</field>
		<field name="res_model">account.asset</field>
		<field name="view_mode">tree,kanban,form</field>
		<field name="search_view_id" ref="view_account_asset_tracking_search" />
		<field name="view_ids" eval="[(5,),
			(0,0, {'sequence' : 1, 'view_mode' : 'kanban', 'view_id' : ref('view_account_asset_kanban_asset_tracking')}),
			(0,0, {'sequence' : 2, 'view_mode' : 'tree', 'view_id' : ref('view_account_asset_tracking_tree')}),
			(0,0, {'sequence' : 3, 'view_mode' : 'form', 'view_id' : ref('view_account_asset_form_asset_tracking')}),
		]" />
	</record>

	<record id="act_asset_location" model="ir.actions.act_window">
		<field name="name">Asset Location</field>
		<field name="res_model">account.asset.location</field>
		<field name="view_mode">tree,form</field>
	</record>

	<record id="act_asset_movement" model="ir.actions.act_window">
		<field name="name">Asset Movement</field>
		<field name="res_model">account.asset.movement</field>
		<field name="view_mode">tree,form</field>
	</record>

	<record id="act_account_asset_attribute" model="ir.actions.act_window">
		<field name="name">Asset Attribute</field>
		<field name="res_model">account.asset.attribute</field>
		<field name="view_mode">tree,form</field>
	</record>


	<record id="act_account_asset_use_state" model="ir.actions.act_window">
		<field name="name">Asset Use Status</field>
		<field name="res_model">account.asset.use.state</field>
		<field name="view_mode">tree</field>
	</record>

	<record id="act_account_asset_dispose_wizard" model="ir.actions.act_window">
		<field name="name">Asset Disposal</field>
		<field name="res_model">account.asset.dispose.wizard</field>
		<field name="view_mode">form</field>
		<field name="target">new</field>
	</record>


	<record model="ir.ui.view" id="view_account_asset_form">
		<field name="name">account.asset.form</field>
		<field name="model">account.asset</field>
		<field name="inherit_id" ref="account_asset.view_account_asset_form" />
		<field name="arch" type="xml">
			<field name="state" position="before">
				<field name="use_state_id" widget="statusbar" options="{'clickable' : 1}" />
			</field>
		</field>
	</record>

	<record model="ir.ui.view" id="view_account_asset_search">
		<field name="name">account.asset.search</field>
		<field name="model">account.asset</field>
		<field name="inherit_id" ref="account_asset.view_account_asset_search" />
		<field name="arch" type="xml">
			<group>
				<filter string="Use Status" name="use_status" domain="[]" context="{'group_by':'use_state_id'}" />
			</group>
		</field>
	</record>


</odoo>