<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

	<record model="account.asset.use.state" id="use_state_new" forcecreate="False">
		<field name="sequence">1</field>
		<field name="name">New</field>
		<field name="value">new</field>
	</record>

	<record model="account.asset.use.state" id="use_state_active" forcecreate="False">
		<field name="sequence">2</field>
		<field name="name">Active</field>
		<field name="value">active</field>
	</record>
	
	<record model="account.asset.use.state" id="use_state_inactive" forcecreate="False">
		<field name="sequence">3</field>
		<field name="name">Inactive</field>
		<field name="value">inactive</field>
	</record>
	
	<record model="account.asset.use.state" id="use_state_scrap" forcecreate="False">
		<field name="sequence">4</field>
		<field name="name">Scrap</field>
		<field name="value">scrap</field>
		<field name="dispose" eval="True" />
	</record>
	

	<record model="account.asset.use.state" id="use_state_sold" forcecreate="False">
		<field name="sequence">5</field>
		<field name="name">Sold</field>
		<field name="value">sold</field>
		<field name="dispose" eval="True" />
	</record>

</odoo>