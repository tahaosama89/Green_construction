<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

	<record id="seq_account_asset_movement" model="ir.sequence" forcecreate="False">
		<field name="name">Asset Movement</field>
		<field name="code">account.asset.movement</field>
		<field name="prefix">AM</field>
		<field name="padding">4</field>
		<field name="company_id" eval="False" />
	</record>
	
	<record id="seq_account_asset_asset" model="ir.sequence" forcecreate="False">
		<field name="name">Asset</field>
		<field name="code">account.asset</field>
		<field name="prefix">A</field>
		<field name="padding">4</field>
		<field name="company_id" eval="False" />
	</record>

	<record id="seq_account_asset_attribute" model="ir.sequence" forcecreate="True">
		<field name="name">Asset Attribute Field Name</field>
		<field name="code">account.asset.attribute</field>
		<field name="prefix">x_</field>
		<field name="padding">3</field>
		<field name="company_id" eval="False" />
	</record>
	
</odoo>